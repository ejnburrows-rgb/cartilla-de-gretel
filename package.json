{
  "name": "cartilla-de-gretel-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm check:sanity && pnpm validate:content && pnpm validate:art-color && pnpm audit:restoration && pnpm audit:flipbook-color && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "node scripts/validate-teacher-guide.cjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:art-color": "node scripts/validate-art-color.mjs",
    "audit:restoration": "node scripts/audit-full-restoration.mjs",
    "audit:flipbook-color": "python3 -m pip install --quiet opencv-python-headless==4.10.0.84 && python3 scripts/audit-flipbook-color-fidelity.py",
    "validate:activities-content": "node scripts/validate-activities-content.mjs",
    "validate:manifest": "node scripts/validate-workbook-manifest.mjs src/content/workbook/workbook-manifest.json",
    "build:manifest": "node scripts/build-workbook-manifest.mjs",
    "seed:manifest": "node scripts/seed-workbook-manifest-from-real-content.mjs",
    "build:full-manifest": "node scripts/build-full-workbook-manifest.mjs",
    "crop:generate-manifest": "node scripts/generate-crop-manifest.mjs",
    "crop:illustrations": "node scripts/crop-illustrations.mjs",
    "check:assets": "ts-node --project tsconfig.json scripts/check-assets.ts",
    "check:sanity": "ts-node --transpile-only scripts/check-assets-and-lessons.ts",
    "status:safe": "pnpm check:sanity",
    "art:extract": "node scripts/extract-art.mjs",
    "art:extract:force": "node scripts/extract-art.mjs --force",
    "art:polish": "node scripts/polish-art.mjs",
    "art:polish:force": "node scripts/polish-art.mjs --force",
    "art:pipeline": "node scripts/extract-art.mjs && node scripts/polish-art.mjs",
    "art:pipeline:force": "node scripts/extract-art.mjs --force && node scripts/polish-art.mjs --force",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:supabase": "node scripts/smoke-supabase.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-pageflip": "^2.0.3",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.52.0",
    "@tanstack/router-plugin": "^1.167.28",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.20.0",
    "canvas": "^3.2.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "pdf2pic": "^3.2.0",
    "playwright": "1.52.0",
    "prettier": "^3.7.3",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  }
}
