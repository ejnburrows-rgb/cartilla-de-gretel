# Public reader and local interactive lessons load without Supabase.
# Add these two values to enable teacher login, classes, join codes, and cloud progress.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Optional: crash reporting and analytics. Both are off (no network calls) unless set.
VITE_SENTRY_DSN=""
VITE_VERCEL_ANALYTICS="0"
