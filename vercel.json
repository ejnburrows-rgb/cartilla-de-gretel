{
  "buildCommand": "pnpm verify:reconstruction || exit 11; pnpm prepare:art || exit 12; pnpm verify:platform || exit 13; pnpm typecheck || exit 14; pnpm test || exit 15; vite build || exit 16",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
