  "assets": [
    {
      "id": "gretel_01",
      "phrase_es": "¡Hola! ¡Qué alegría verte otra vez!",
      "duration_s": 2.976,
      "path": "/audio/gretel/clips/rec_gretel_01.mp3"
    },
    {
      "id": "gretel_02",
      "phrase_es": "Soy Gretel, y hoy vamos a aprender juntos.",
      "duration_s": 3.624,
      "path": "/audio/gretel/clips/rec_gretel_02.mp3"
    },
    {
      "id": "gretel_03",
      "phrase_es": "¿Sabes qué? ¡Tengo algo muy bonito que enseñarte!",
      "duration_s": 4.32,
      "path": "/audio/gretel/clips/rec_gretel_03.mp3"
    },
    {
      "id": "gretel_04",
      "phrase_es": "¡Mira cuántas cosas nuevas podemos descubrir!",
      "duration_s": 3.192,
      "path": "/audio/gretel/clips/rec_gretel_04.mp3"
    },
    {
      "id": "gretel_05",
      "phrase_es": "¿Estás listo? ¡Pues vamos a comenzar!",
      "duration_s": 3.672,
      "path": "/audio/gretel/clips/rec_gretel_05.mp3"
    },
    {
      "id": "gretel_06",
      "phrase_es": "¡Me encanta aprender contigo!",
      "duration_s": 3.024,
      "path": "/audio/gretel/clips/rec_gretel_06.mp3"
    },
    {
      "id": "gretel_07",
      "phrase_es": "Escucha con atención. Esta es la letra A.",
      "duration_s": 4.704,
      "path": "/audio/gretel/clips/rec_gretel_07.mp3"
    },
    {
      "id": "gretel_08",
      "phrase_es": "A... E... I... O... U. ¡Son las cinco vocales!",
      "duration_s": 5.472,
      "path": "/audio/gretel/clips/rec_gretel_08.mp3"
    },
    {
      "id": "gretel_09",
      "phrase_es": "Ahora, vamos a decirlas juntos, despacito.",
      "duration_s": 4.272,
      "path": "/audio/gretel/clips/rec_gretel_09.mp3"
    },
    {
      "id": "gretel_10",
      "phrase_es": "Mira la letra. Escucha su sonido. Ahora repítelo tú.",
      "duration_s": 4.944,
      "path": "/audio/gretel/clips/rec_gretel_10.mp3"
    },
    {
      "id": "gretel_11",
      "phrase_es": "La letra M con la vocal A forman la sílaba ma.",
      "duration_s": 6.168,
      "path": "/audio/gretel/clips/rec_gretel_11.mp3"
    },
    {
      "id": "gretel_12",
      "phrase_es": "Ma... me... mi... mo... mu. ¡Excelente!",
      "duration_s": 8.736,
      "path": "/audio/gretel/clips/rec_gretel_12.mp3"
    },
    {
      "id": "gretel_13",
      "phrase_es": "Escucha las dos palabras: mamá... mapa.",
      "duration_s": 8.76,
      "path": "/audio/gretel/clips/rec_gretel_13.mp3"
    },
    {
      "id": "gretel_14",
      "phrase_es": "¿Qué sonido escuchas al principio?",
      "duration_s": 3.24,
      "path": "/audio/gretel/clips/rec_gretel_14.mp3"
    },
    {
      "id": "gretel_15",
      "phrase_es": "Prepara tu lápiz. Vamos a escribir una letra.",
      "duration_s": 5.232,
      "path": "/audio/gretel/clips/rec_gretel_15.mp3"
    },
    {
      "id": "gretel_16",
      "phrase_es": "Escucha primero. Después, escribe lo que escuchaste.",
      "duration_s": 4.944,
      "path": "/audio/gretel/clips/rec_gretel_16.mp3"
    },
    {
      "id": "gretel_17",
      "phrase_es": "Voy a repetirlo más despacio.",
      "duration_s": 3.192,
      "path": "/audio/gretel/clips/rec_gretel_17.mp3"
    },
    {
      "id": "gretel_18",
      "phrase_es": "Escucha esta sílaba: pa.",
      "duration_s": 2.304,
      "path": "/audio/gretel/clips/rec_gretel_18.mp3"
    },
    {
      "id": "gretel_19",
      "phrase_es": "Ahora escribe la sílaba que acabas de escuchar.",
      "duration_s": 6.432,
      "path": "/audio/gretel/clips/rec_gretel_19.mp3"
    },
    {
      "id": "gretel_20",
      "phrase_es": "Muy bien. Vamos a escucharla una vez más.",
      "duration_s": 4.272,
      "path": "/audio/gretel/clips/rec_gretel_20.mp3"
    },
    {
      "id": "gretel_21",
      "phrase_es": "Observa la palabra: mesa. Me-sa. Tiene dos sílabas.",
      "duration_s": 6.816,
      "path": "/audio/gretel/clips/rec_gretel_21.mp3"
    },
    {
      "id": "gretel_22",
      "phrase_es": "Ahora intenta leerla tú solito.",
      "duration_s": 3.408,
      "path": "/audio/gretel/clips/rec_gretel_22.mp3"
    },
    {
      "id": "gretel_23",
      "phrase_es": "¡Sí! ¡Lo hiciste muy bien!",
      "duration_s": 3.216,
      "path": "/audio/gretel/clips/rec_gretel_23.mp3"
    },
    {
      "id": "gretel_24",
      "phrase_es": "¡Exactamente! ¡Esa es la respuesta!",
      "duration_s": 3.792,
      "path": "/audio/gretel/clips/rec_gretel_24.mp3"
    },
    {
      "id": "gretel_25",
      "phrase_es": "¡Qué bien estás aprendiendo!",
      "duration_s": 2.904,
      "path": "/audio/gretel/clips/rec_gretel_25.mp3"
    },
    {
      "id": "gretel_26",
      "phrase_es": "¡Lo descubriste! ¡Sabía que podías hacerlo!",
      "duration_s": 3.816,
      "path": "/audio/gretel/clips/rec_gretel_26.mp3"
    },
    {
      "id": "gretel_27",
      "phrase_es": "¡Cada vez lo haces mejor!",
      "duration_s": 2.424,
      "path": "/audio/gretel/clips/rec_gretel_27.mp3"
    },
    {
      "id": "gretel_28",
      "phrase_es": "¡Fantástico! ¡Estoy muy contenta!",
      "duration_s": 3.456,
      "path": "/audio/gretel/clips/rec_gretel_28.mp3"
    },
    {
      "id": "gretel_29",
      "phrase_es": "Casi lo tienes. Vamos a intentarlo otra vez.",
      "duration_s": 4.056,
      "path": "/audio/gretel/clips/rec_gretel_29.mp3"
    },
    {
      "id": "gretel_30",
      "phrase_es": "No pasa nada. Aprender también significa practicar.",
      "duration_s": 4.632,
      "path": "/audio/gretel/clips/rec_gretel_30.mp3"
    },
    {
      "id": "gretel_31",
      "phrase_es": "Escuchemos el sonido una vez más.",
      "duration_s": 3.048,
      "path": "/audio/gretel/clips/rec_gretel_31.mp3"
    },
    {
      "id": "gretel_32",
      "phrase_es": "¡Buen intento! Te voy a dar una pequeña pista.",
      "duration_s": 4.2,
      "path": "/audio/gretel/clips/rec_gretel_32.mp3"
    },
    {
      "id": "gretel_33",
      "phrase_es": "Mira con atención. Hay algo que podemos corregir.",
      "duration_s": 4.392,
      "path": "/audio/gretel/clips/rec_gretel_33.mp3"
    },
    {
      "id": "gretel_34",
      "phrase_es": "Vamos despacito. Yo te ayudo.",
      "duration_s": 2.712,
      "path": "/audio/gretel/clips/rec_gretel_34.mp3"
    },
    {
      "id": "gretel_35",
      "phrase_es": "¡Ahora viene mi parte favorita!",
      "duration_s": 2.736,
      "path": "/audio/gretel/clips/rec_gretel_35.mp3"
    },
    {
      "id": "gretel_36",
      "phrase_es": "Toca la letra que escuches.",
      "duration_s": 2.064,
      "path": "/audio/gretel/clips/rec_gretel_36.mp3"
    },
    {
      "id": "gretel_37",
      "phrase_es": "Busca el dibujo que comienza con este sonido.",
      "duration_s": 3.864,
      "path": "/audio/gretel/clips/rec_gretel_37.mp3"
    },
    {
      "id": "gretel_38",
      "phrase_es": "Cuando estés listo, toca el micrófono y habla.",
      "duration_s": 3.24,
      "path": "/audio/gretel/clips/rec_gretel_38.mp3"
    },
    {
      "id": "gretel_39",
      "phrase_es": "¡Te escucho! Di la palabra en voz alta.",
