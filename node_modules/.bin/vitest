#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/node_modules/.pnpm/vitest@4.1.8_@types+node@22.19.19_jsdom@29.1.1_canvas@3.2.3__vite@7.3.3_@types+node@22._5d6e5504655f37a8209a39a4ce7a0c27/node_modules/vitest/node_modules:/workspace/node_modules/.pnpm/vitest@4.1.8_@types+node@22.19.19_jsdom@29.1.1_canvas@3.2.3__vite@7.3.3_@types+node@22._5d6e5504655f37a8209a39a4ce7a0c27/node_modules:/workspace/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/node_modules/.pnpm/vitest@4.1.8_@types+node@22.19.19_jsdom@29.1.1_canvas@3.2.3__vite@7.3.3_@types+node@22._5d6e5504655f37a8209a39a4ce7a0c27/node_modules/vitest/node_modules:/workspace/node_modules/.pnpm/vitest@4.1.8_@types+node@22.19.19_jsdom@29.1.1_canvas@3.2.3__vite@7.3.3_@types+node@22._5d6e5504655f37a8209a39a4ce7a0c27/node_modules:/workspace/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../vitest/vitest.mjs" "$@"
else
  exec node  "$basedir/../vitest/vitest.mjs" "$@"
fi
